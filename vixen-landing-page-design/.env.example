# ============================================================
# ServiceSync Environment Configuration
# ============================================================

# 1. Supabase Backend (Database + Authentication)
# Get these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Standalone Google Cloud OAuth (Optional if using Supabase Google Auth)
# If using Supabase Google Auth, configure Google Provider in Supabase Dashboard instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
